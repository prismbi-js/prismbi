{
  "name": "@prismbi/prismbi",
  "version": "0.6.0",
  "description": "PrismBI - Power BI-style data modeling and interactive reports for the web, in TypeScript. DAX-like engine, 34 visuals, slicing and cross-filtering, a drag-and-drop studio, connectors, a Web Worker engine, AI questions/insights/agent tools, web components and React bindings. Zero dependencies.",
  "keywords": [
    "bi",
    "business-intelligence",
    "dashboard",
    "power-bi",
    "dax",
    "charts",
    "data-visualization",
    "report",
    "analytics",
    "react",
    "typescript",
    "olap",
    "pivot",
    "report-builder",
    "web-components",
    "ai",
    "agents",
    "mcp",
    "csv",
    "streaming",
    "web-worker"
  ],
  "license": "MIT",
  "author": "Santhoshkumar Hariharan",
  "type": "module",
  "sideEffects": [
    "./dist/ai.js",
    "./dist/ai.cjs",
    "./dist/elements.js",
    "./dist/elements.cjs",
    "./dist/index.js",
    "./dist/index.cjs",
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "@prismbi/prismbi": "bin/prismbi.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./visuals": {
      "types": "./dist/visuals.d.ts",
      "import": "./dist/visuals.js",
      "require": "./dist/visuals.cjs"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js",
      "require": "./dist/studio.cjs"
    },
    "./connectors": {
      "types": "./dist/connectors.d.ts",
      "import": "./dist/connectors.js",
      "require": "./dist/connectors.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "require": "./dist/files.cjs"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite --config examples/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhoshkumarhari/PrismBI.git"
  },
  "homepage": "https://github.com/santhoshkumarhari/PrismBI#readme",
  "bugs": {
    "url": "https://github.com/santhoshkumarhari/PrismBI/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
