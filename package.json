{
  "name": "prismbi",
  "version": "0.1.0",
  "description": "PrismBI - a Power BI-style, TypeScript-first data modeling & interactive report engine for the web. Columnar data model, DAX-like formulas, cross-filtering visuals, themes, and React bindings.",
  "keywords": [
    "bi",
    "business-intelligence",
    "dashboard",
    "power-bi",
    "dax",
    "charts",
    "data-visualization",
    "report",
    "analytics",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "author": "Santhoshkumar Hariharan",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prismbi": "./bin/prismbi.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./visuals": {
      "types": "./dist/visuals.d.ts",
      "import": "./dist/visuals.js",
      "require": "./dist/visuals.cjs"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js",
      "require": "./dist/studio.cjs"
    },
    "./connectors": {
      "types": "./dist/connectors.d.ts",
      "import": "./dist/connectors.js",
      "require": "./dist/connectors.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "require": "./dist/files.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite --config examples/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
